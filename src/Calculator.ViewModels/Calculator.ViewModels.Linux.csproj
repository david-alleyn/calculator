<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Linux target of Calculator.ViewModels (Avalonia/Linux migration, Phase 1).
    Shares all sources with the UWP project in this folder; platform-specific
    implementations live under Platform/Linux and are guarded with
    #if WINDOWS_UWP / #else in the shared files where needed.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CalculatorApp.ViewModel</RootNamespace>
    <AssemblyName>Calculator.ViewModels</AssemblyName>
    <LangVersion>13.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The generated Localization/*.resx are added by the target below; the
         default glob would double-include them on incremental builds. -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="Platform\Windows\**\*.cs;bin\**\*.cs;obj\**\*.cs" />
    <EmbeddedResource Include="Properties\Calculator.ViewModels.rd.xml" />
  </ItemGroup>

  <!--
    Linux localization: convert the shared .resw catalogs to .resx at build time
    (python3) and embed them for ResourceManager lookup. en-US becomes the
    neutral resources and every other locale a satellite assembly.
  -->
  <PropertyGroup>
    <LocalizationDir>$(MSBuildProjectDirectory)\Localization\</LocalizationDir>
    <Resw2ResxScript>$(MSBuildThisFileDirectory)..\..\Tools\resw2resx\resw2resx.py</Resw2ResxScript>
    <PythonExe Condition="'$(PythonExe)' == ''">python3</PythonExe>
  </PropertyGroup>

  <ItemGroup>
    <ReswLocalizationSource Include="..\Calculator\Resources\**\*.resw" />
  </ItemGroup>

  <Target Name="GenerateLocalizationCatalogs"
          BeforeTargets="PrepareForBuild"
          Inputs="@(ReswLocalizationSource)"
          Outputs="$(LocalizationDir)localization.stamp">
    <MakeDir Directories="$(LocalizationDir)" />
    <Exec Command="&quot;$(PythonExe)&quot; &quot;$(Resw2ResxScript)&quot; --out &quot;$(LocalizationDir)&quot; --layout flat"
          StandardOutputImportance="low" />
    <Touch Files="$(LocalizationDir)localization.stamp" AlwaysCreate="true" />
  </Target>

  <!-- Always declared (the generation target may be skipped as up to date). -->
  <Target Name="AddLocalizationResources"
          BeforeTargets="PrepareForBuild"
          DependsOnTargets="GenerateLocalizationCatalogs">
    <ItemGroup>
      <!-- Generated under the project so the SDK derives standard manifest
           names (CalculatorApp.ViewModel.Localization.Resources plus one
           satellite per locale). The folder is git-ignored. Remove first so
           repeated target invocations cannot duplicate the items. -->
      <EmbeddedResource Remove="$(LocalizationDir)*.resx" />
      <EmbeddedResource Include="$(LocalizationDir)*.resx" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

</Project>
